          "type": "object",
          "properties": {
            "path": {
              "description": "Path to the `.nid` AFM image file.\nFull file path to a Nanosurf `.nid` AFM image file. This file is read and processed to extract imaging data.",
              "type": "string"
            },
            "dynamic_code": {
              "description": "Custom Python code to modify image data access logic.\nExecuted at runtime to override the default image channel. Useful for switching to different imaging modes such as Deflection or Friction Force, or for accessing Backward scan data.",
              "type": "string"
