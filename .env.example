# Example .env file for Corral Docker Compose
# Copy this file to .env and customize for your environment

# Port mappings (host:container)
MD_PORT=8000
CATALYST_PORT=8001
ML_PORT=8002
SPECTRA_PORT=8003
AFM_PORT=8004

# Environment modules (Python import paths)
MD_ENV_MODULE=tasks.corral_md.src.corral_md.env
CATALYST_ENV_MODULE=tasks.catalyst.src.catalyst.env
ML_ENV_MODULE=tasks.ml.src.ml.env
SPECTRA_ENV_MODULE=tasks.spectra_elucidation.spectra_elucidation.env
AFM_ENV_MODULE=tasks.afm.src.env

# Custom command-line arguments (space-separated)
# These are passed directly to the env.py module
MD_COMMAND=--dir /workspace --port 8000 --subtask_level true --environment production --level 1
SPECTRA_COMMAND=--host 0.0.0.0 --port 8000 --subtask_level false

# Additional environment-specific settings
ML_TASKS_PATH=/app/tasks/ml/config/dataset.json

# Add your own environment!
# MY_CUSTOM_ENV_MODULE=tasks.my_task.src.my_task.env
# MY_CUSTOM_PORT=8005
# MY_CUSTOM_COMMAND=--your --custom --args
