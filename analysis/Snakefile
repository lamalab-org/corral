PYTHON = "uv run --project .. python"

rule all:
    input:
        "results/data/reports.jsonl",
        "results/data/qa_topic_reports.jsonl",
        "results/data/logprobs.jsonl",
        "results/figures/fig_4_app/app_fig4_behavior_panel.pdf",
        "results/figures/fig_5_app/app_fig5_ver1.pdf",
        "results/figures/analysis/avg_output_tokens_per_message_by_environment.pdf",
        "results/figures/analysis/avg_output_tokens_per_message_by_model_symlog.pdf",
        "results/figures/analysis/avg_output_tokens_per_message_by_agent_type_symlog.pdf",
        "results/figures/analysis/avg_tool_calls_per_task_by_environment.pdf",
        "results/figures/analysis/avg_tool_calls_per_task_by_model.pdf",
        "results/figures/analysis/avg_tool_calls_per_task_by_agent_type.pdf",
        "results/figures/analysis/action_distribution_by_environment_and_agent.pdf",
        "results/figures/analysis/action_distribution_by_environment_and_model.pdf",


rule download_reports:
    output:
        "results/data/reports.jsonl",
    log:
        "results/logs/download_reports.log",
    shell:
        "{PYTHON} download_reports_from_hf.py > {log} 2>&1"


rule download_qa_topic_reports:
    output:
        "results/data/qa_topic_reports.jsonl",
    log:
        "results/logs/download_qa_topic_reports.log",
    shell:
        "{PYTHON} download_qa_topic_reports_from_hf.py > {log} 2>&1"


rule download_logprobs:
    output:
        "results/data/logprobs.jsonl",
    log:
        "results/logs/download_logprobs.log",
    shell:
        "{PYTHON} download_logprobs_from_hf.py > {log} 2>&1"
