rule all:
    input:
        "results/data/reports.jsonl",
        "results/data/qa_topic_reports.jsonl",
        "results/figures/app_fig5_ver1.pdf",


rule download_reports:
    output:
        "results/data/reports.jsonl",
    log:
        "results/logs/download_reports.log",
    shell:
        "python download_reports_from_hf.py > {log} 2>&1"


rule download_qa_topic_reports:
    output:
        "results/data/qa_topic_reports.jsonl",
    log:
        "results/logs/download_qa_topic_reports.log",
    shell:
        "python download_qa_topic_reports_from_hf.py > {log} 2>&1"


rule plot_env_verbosity_performance:
    input:
        "results/data/reports.jsonl",
    output:
        "results/figures/app_fig5_ver1.pdf",
    log:
        "results/logs/plot_env_verbosity_performance.log",
    shell:
        "python plot_env_verbosity_performance.py > {log} 2>&1"
