        model_num=lambda wc: [k for k, v in LFM_BIN_MODEL_NAMES.items() if v == wc.model_name][0],
    shell:
        "python {LFM_BIN_DIR}/fit.py --model {params.model_num} --data {input} --output {LFM_BIN_RESULTS} > {log} 2>&1"


# Convenience targets: snakemake lfm_bin_fit_model1, lfm_bin_fit_model3, etc.
for _num, _name in LFM_BIN_MODEL_NAMES.items():
    rule:
        name: f"lfm_bin_fit_model{_num}"
        input: f"{LFM_BIN_RESULTS}/{_name}_trace.nc"


rule lfm_bin_fit_all:
    input: LFM_BIN_ALL_TRACES


