rule all:
    input:
        "results/data/reports.jsonl",
        "results/data/qa_topic_reports.jsonl",


rule download_reports:
    output:
        "results/data/reports.jsonl",
    log:
        "results/logs/download_reports.log",
    shell:
        "python download_reports_from_hf.py > {log} 2>&1"


rule download_qa_topic_reports:
    output:
        "results/data/qa_topic_reports.jsonl",
    log:
        "results/logs/download_qa_topic_reports.log",
    shell:
        "python download_qa_topic_reports_from_hf.py > {log} 2>&1"


### Annotation figure scripts

rule retrieve_annotations_from_mongo:
    output:
        "data/annotation_data/corral_dump.json",
    log:
        "results/logs/retrieve_annotations_from_mongo.log",
    shell:
        "python retrieve_annotations_from_mongo.py > {log} 2>&1"

rule filter_annotations:
    input:
        "data/annotation_data/corral_dump.json",
    output:
        "results/data/filtered_annotations.json",
    log:
        "results/logs/filter_annotations.log",
    shell:
        "python filter_annotations.py > {log} 2>&1"

rule plot_marker_vs_scaffold:
    input:
        "results/data/filtered_annotations.json",
    output:
        "results/figures/fig_5/marker_impact_raw_counts.pdf",
        "results/figures/fig_5/stacked_regression_raw_counts.pdf",
    log:
        "results/logs/plot_marker_vs_scaffold.log",
    shell:
        "python plot_marker_vs_scaffold.py > {log} 2>&1"
