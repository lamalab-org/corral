rule all:
    input:
        # Baseline model (no task or category effects)
        "results/irt_baseline/agent_trace.nc",
        "results/irt_baseline/results.json",
        # Category effects only
        "results/irt_category/agent_trace.nc",
        "results/irt_category/results.json",
        # Task effects only
        "results/irt_task/agent_trace.nc",
        "results/irt_task/results.json",
        # Both category and task effects
        "results/irt_category_task/agent_trace.nc",
        "results/irt_category_task/results.json",
        # Model 3: Environment-specific ability slopes + tasks (best model)
        "results/model3_abilities_env/agent_trace.nc",
        "results/model3_abilities_env/results.json",


