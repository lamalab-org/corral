# LAMMPS Input Script for calculating cohesive energy for Aluminum

units metal
dimension 3
boundary p p p
#atom_style should be consistent with all tasks
atom_style atomic

read_data ../../lattice_generation/task_1/structure.xyz

#-------------------------Potential---------------------------#

# Define the potential for aluminum

pair_style      eam/alloy  #ablation 
pair_coeff      * * /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_3/Al99.eam.alloy Al     

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ---------- Define Settings --------------------- 
compute eng all pe/atom 
compute eatoms all reduce sum c_eng 

#-----------------------Minimization--------------------------#

# Perform energy minimization
fix 1 all box/relax iso 0.0 vmax 0.001 
thermo          10
thermo_style    custom step atoms temp pe ke etotal press
#specify minimiser
min_style       cg 
minimize        1e-25 1e-25 5000 10000 #ablation

write_data      minimized_aluminum_structure.xyz

variable natoms equal "count(all)" 
variable teng equal "c_eatoms"
variable length equal "lx"
variable ecoh equal "v_teng/v_natoms"

print "Total energy (eV) = ${teng};"
print "Number of atoms = ${natoms};"
print "Lattice constant (Angstoms) = ${length};"
print "Cohesive energy (eV) = ${ecoh};"

