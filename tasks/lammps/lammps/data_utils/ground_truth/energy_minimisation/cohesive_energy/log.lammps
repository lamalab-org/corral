LAMMPS (19 Nov 2024 - Development - patch_19Nov2024-56-ga78aee5731)
# LAMMPS Input Script for FCC Lattice of Aluminum

units metal
dimension 3
boundary p p p
#atom_style should be consistent with all tasks
atom_style atomic

read_data ../../lattice_generation/task_1/structure.xyz
Reading data file ...
  orthogonal box = (0 0 0) to (4 4 4)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  4 atoms
  reading velocities ...
  4 velocities
  read_data CPU = 0.005 seconds

#-------------------------Potential---------------------------#

# Define the potential for aluminum

pair_style      eam/alloy  #ablation
pair_coeff      * * /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_3/Al99.eam.alloy Al

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ---------- Define Settings ---------------------
compute eng all pe/atom
compute eatoms all reduce sum c_eng

#-----------------------Minimization--------------------------#

# Perform energy minimization
fix 1 all box/relax iso 0.0 vmax 0.001
thermo          10
thermo_style    custom step atoms temp pe ke etotal press
#specify minimiser
min_style       cg
minimize        1e-25 1e-25 5000 10000 #ablation
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 8.28721
  ghost atom cutoff = 8.28721
  binsize = 4.143605, bins = 1 1 1
  1 neighbor lists, perpetual/occasional/extra = 1 0 0
  (1) pair eam/alloy, perpetual
      attributes: half, newton on
      pair build: half/bin/atomonly/newton
      stencil: half/bin/3d
      bin: standard
