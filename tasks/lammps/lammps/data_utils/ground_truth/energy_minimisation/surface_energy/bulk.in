# LAMMPS Input Script for Bulk Energy Calculation

units metal
dimension 3
boundary p p p  # Periodic in all directions (Bulk System)
atom_style atomic

# Read initial FCC aluminum structure (fully periodic)
read_data ../../lattice_generation/task_1/structure.xyz

# ------------------------- Potential ---------------------------#
pair_style eam/alloy  
pair_coeff * * /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_3/Al99.eam.alloy Al     

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

# ----------------------- Bulk Minimization --------------------------#
fix 1 all box/relax iso 0.0 vmax 0.001 
thermo 10
thermo_style custom step atoms temp pe ke etotal press

# Minimize energy for bulk system (periodic boundary conditions)
min_style cg 
minimize 1e-25 1e-25 5000 10000 

write_data bulk.xyz  # Save bulk structure after minimization
variable E_bulk equal pe  # Store bulk energy

# Output the bulk energy
print "Bulk Energy (eV) = ${E_bulk}"