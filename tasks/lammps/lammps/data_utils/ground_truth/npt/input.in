# LAMMPS Input Script for FCC Lattice of Aluminum

units metal
dimension 3
boundary p p p
#atom_style should be consistent with all tasks
atom_style atomic

read_data      ../energy_minimisation/minimized_aluminum_structure.dat

#-------------------------Potential---------------------------#

# Define the potential for aluminum

pair_style      eam/alloy  #ablation 
pair_coeff      * * /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_3/Al99.eam.alloy Al     

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

#-------------------NPT Simulation for Density Calculation---#

# Perform NPT simulation to equilibrate the system
velocity all create 300.0 12345
timestep        0.001
fix             npt all npt temp 300.0 300.0 100.0 iso 0.0 0.0 1000.0
dump            npt_dump all custom 2 npt_aluminum_density.lammpstrj id type x y z
thermo          2
thermo_style    custom step temp press density
run             10
unfix           npt
undump          npt_dump

