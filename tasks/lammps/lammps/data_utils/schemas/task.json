{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique identifier for the task."
    },
    "task_name": {
      "type": "string",
      "description": "Name of the task."
    },
    "task_prompt": {
      "type": "string",
      "description": "Prompt for the task."
    },
    "task_properties": {
      "type": "object",
      "description": "Properties specific to the task.",
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "description": "List of tools required for the task.",
      "items": {
        "type": "string"
      }
    },
    "subtasks": {
      "type": "array",
      "description": "List of subtasks associated with the task.",
      "items": {
        "$ref": "#/$defs/subtask"
      }
    }
  },
  "required": ["task_id", "task_name", "task_prompt", "task_properties", "tools", "subtasks"],
  "$defs": {
    "subtask": {
      "type": "object",
      "properties": {
        "subtask_id": {
          "type": "string",
          "description": "Unique identifier for the subtask."
        },
        "name": {
          "type": "string",
          "description": "Name of the subtask."
        },
        "description": {
          "type": "string",
          "description": "Description of the subtask."
        },
        "tools": {
          "type": "array",
          "description": "List of tools required for the subtask.",
          "items": {
            "type": "string"
          }
        },
        "scoring_fn": {
          "type": "string",
          "description": "Scoring function to evaluate the subtask."
        },
        "submission_format": {
          "type": ["string", "null"],
          "description": "Expected format of the subtask submission."
        },
        "metric": {
          "type": "string",
          "description": "Metric used to evaluate the subtask."
        },
        "initial_input": {
          "type": ["object", "null"],
          "description": "Initial input for the subtask. Can be a dictionary or null."
        },
        "input_from_task": {
          "type": ["array", "null"],
          "description": "List of subtask IDs that this subtask depends on. Can be an array or null.",
          "items": {
            "type": "string"
          }
        },
        "ground_truth": {
          "type": "array",
          "description": "List of ground truth entries for the subtask.",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Type of ground truth."
              },
              "properties": {
                "type": "object",
                "description": "Key-value pairs for the ground truth.",
                "additionalProperties": true
              }
            },
            "required": ["type", "properties"]
          }
        }
      },
      "required": ["subtask_id", "name", "description", "tools", "scoring_fn", "metric"]
    }
  }
}