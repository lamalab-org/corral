units           real
atom_style      full
boundary        p p p

read_data       ../../structure/Si/Si.data
replicate       2 2 2

# -----------------------------
# COMB3 / ReaxFF Pair Style and Coefficients
# -----------------------------
pair_style      reaxff NULL safezone 100 mincap 10000
pair_coeff      * * ../../potentials/ffield.reax Si

fix             qeq all qeq/reaxff 1 0.0 10.0 1e-6 reaxff

# -----------------------------
# Neighbor and Thermo Settings
# -----------------------------
neighbor        2.0 bin 
neigh_modify    delay 10 check yes

# ---------- Define Settings --------------------- 
compute eng all pe/atom 
compute eatoms all reduce sum c_eng 

# -----------------------------
# Energy Minimization (Bulk)
# -----------------------------
reset_timestep  0 
thermo          10 
thermo_style    custom step pe lx ly lz press pxx pyy pzz c_eatoms 
min_style       cg
minimize        1.0e-10 1.0e-10 100000 100000

# Store bulk energy and atom count
variable        Ebulk equal pe
variable        Nbulk equal count(all)
variable        Ebulk_peratom equal ${Ebulk}/${Nbulk}

# -----------------------------
# Create Slab
# -----------------------------
change_box      all boundary p p s  # Free surface in z-direction
write_data      ../../slab/Si/Si_slab.data

# Re-read slab to reset system
#read_data       ../../slab/Si/Si_slab.data

# Re-apply force field and charges
pair_style      reaxff NULL safezone 100 mincap 10000
pair_coeff      * * ../../potentials/ffield.reax Si
fix             qeq all qeq/reaxff 1 0.0 10.0 1e-6 reaxff

compute eng all pe/atom 
compute eatoms all reduce sum c_eng 

# Energy Minimization (Slab)
reset_timestep  0
thermo          100
min_style       cg
minimize        1.0e-10 1.0e-10 100000 100000

# Slab energy and atom count
variable        Eslab equal pe
variable        Nslab equal count(all)

# Scale bulk energy to match number of slab atoms
variable        Ebulk_scaled equal ${Ebulk_peratom}*${Nslab}

# Surface area (top and bottom)
variable        A equal lx*ly

# Surface energy calculation
variable        surface_energy equal (${Eslab}-${Ebulk_scaled})/(${A}*2)

# Print results
print "Slab Energy (kcal/mol): ${Eslab}"
print "Bulk Energy per Atom (kcal/mol): ${Ebulk_peratom}"
print "Scaled Bulk Energy (kcal/mol): ${Ebulk_scaled}"
print "Surface Area (Å^2): ${A}"
print "Surface Energy (kcal/mol·Å^2): ${surface_energy}"

# Write to file
print "${surface_energy}" file surface_energy.txt