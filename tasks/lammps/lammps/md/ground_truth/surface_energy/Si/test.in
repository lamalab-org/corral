# Surface Energy Calculation for Silicon using COMB3

units           real
atom_style      full
boundary        p p p  # Periodic for bulk

# -----------------------------
# Read Bulk Structure
# -----------------------------
read_data       ../../structure/Si/Si.data
replicate       2 2 2  # Adjust as needed for a representative bulk

# -----------------------------
# Potential Setup (COMB3 style)
# -----------------------------
pair_style      reaxff NULL safezone 100 mincap 10000
pair_coeff      * * ../../potentials/ffield_UTA1.ITT Si

fix             qeq all qeq/reaxff 1 0.0 10.0 1e-6 reaxff

# -----------------------------
# Compute Bulk Energy Per Atom
# -----------------------------
compute         pe_atom all pe/atom
compute         Ebulk all reduce sum c_pe_atom
variable        N_bulk equal count(all)
variable        Ebulk_per_atom equal c_Ebulk/v_N_bulk

# -----------------------------
# Bulk Energy Minimization
# -----------------------------
reset_timestep  0
thermo          10
thermo_style    custom step pe lx ly lz press c_Ebulk v_Ebulk_per_atom
min_style       cg
minimize        1.0e-10 1.0e-10 100000 100000

# -----------------------------
# Create Slab (Free Surface in z-direction)
# -----------------------------
# This introduces two surfaces: top and bottom
change_box      all boundary p p s  # s = shrink-wrapped z (non-periodic)

# Store box dimensions (for surface area later)
variable        A equal lx*ly

# -----------------------------
# Re-Minimize the Slab Structure
# -----------------------------
reset_timestep  0
thermo          50
minimize        1.0e-10 1.0e-10 100000 100000

# -----------------------------
# Slab Energy Calculation
# -----------------------------
variable        Eslab equal pe
variable        N_slab equal count(all)

# Surface Energy Calculation (kcal/mol/Å²)
#variable        surf_energy equal (${Eslab} - ${N_slab} * ${Ebulk_per_atom})/(2.0*${A})

variable        Ebulk equal ${N_slab}*${Ebulk_per_atom}

variable         surf_energy equal (${Eslab}-${Ebulk})/(2.0*${A})


# -----------------------------
# Output Results
# -----------------------------
print "Bulk energy per atom = ${Ebulk_per_atom} kcal/mol"
print "Total slab energy     = ${Eslab} kcal/mol"
print "Surface area (lx*ly)  = ${A} Å^2"
print "Surface energy        = ${surf_energy} kcal/mol/Å^2"

# Save to file for record
print "${surf_energy}" file surface_energy.txt
