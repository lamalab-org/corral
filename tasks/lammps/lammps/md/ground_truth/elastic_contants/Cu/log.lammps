variable tmp equal pxx
variable pxx0 equal ${tmp}
variable pxx0 equal 306.149556085471
variable tmp equal pyy
variable pyy0 equal ${tmp}
variable pyy0 equal 306.149556085365
variable tmp equal pzz
variable pzz0 equal ${tmp}
variable pzz0 equal 306.14955608532
variable tmp equal pyz
variable pyz0 equal ${tmp}
variable pyz0 equal -2.98989497486834e-11
variable tmp equal pxz
variable pxz0 equal ${tmp}
variable pxz0 equal 3.78764831128271e-11
variable tmp equal pxy
variable pxy0 equal ${tmp}
variable pxy0 equal -4.00166935209586e-11

variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 3.614693
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 3.614693
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 3.614693

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-306.149556085471)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-306.149556085471)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-306.149556085365)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-306.149556085365)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-306.14955608532)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-306.14955608532)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
variable d4 equal -(v_pyz1--2.98989497486834e-11)/(v_delta/v_len0)*${cfac}
variable d4 equal -(v_pyz1--2.98989497486834e-11)/(v_delta/v_len0)*0.0001
variable d5 equal -(v_pxz1-${pxz0})/(v_delta/v_len0)*${cfac}
variable d5 equal -(v_pxz1-3.78764831128271e-11)/(v_delta/v_len0)*${cfac}
variable d5 equal -(v_pxz1-3.78764831128271e-11)/(v_delta/v_len0)*0.0001
variable d6 equal -(v_pxy1-${pxy0})/(v_delta/v_len0)*${cfac}
variable d6 equal -(v_pxy1--4.00166935209586e-11)/(v_delta/v_len0)*${cfac}
variable d6 equal -(v_pxy1--4.00166935209586e-11)/(v_delta/v_len0)*0.0001

displace_atoms all random ${atomjiggle} ${atomjiggle} ${atomjiggle} 87287 units box
displace_atoms all random 1e-05 ${atomjiggle} ${atomjiggle} 87287 units box
displace_atoms all random 1e-05 1e-05 ${atomjiggle} 87287 units box
displace_atoms all random 1e-05 1e-05 1e-05 87287 units box
Displacing atoms ...

# Write restart
unfix 3
write_restart restart.equil
