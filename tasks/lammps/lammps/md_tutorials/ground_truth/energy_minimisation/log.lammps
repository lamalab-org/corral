LAMMPS (19 Nov 2024 - Development - patch_19Nov2024-56-ga78aee5731)
# ---------- Initialize Simulation ---------------------
clear
units           metal
dimension       3
processors      * * *
atom_style      atomic
boundary        p p p

# ---------- Create Atoms ---------------------
lattice 	fcc 4.05 #This changes results
Lattice spacing in x,y,z = 4.05 4.05 4.05
region	box block 0 5 0 5 0 5 units lattice
create_box	1 box
Created orthogonal box = (0 0 0) to (20.25 20.25 20.25)
  1 by 1 by 1 MPI processor grid
create_atoms 1 box
Created 500 atoms
  using lattice units in orthogonal box = (0 0 0) to (20.25 20.25 20.25)
  create_atoms CPU = 0.000 seconds

mass 1 26.98

# ---------- Define Filename Prefix ---------------------
#variable file_prefix string "${element}_${lattype}_${latconst}_${minimiser_style}"

# ---------- Save Log File with Dynamic Name ---------------------
#log ${file_prefix}_log.lammps

# ---------- Save Initial Structure ---------------------
write_data Al_initial_structure.xyz
System init for write_data ...
WARNING: Communication cutoff is 0.0. No ghost atoms will be generated. Atoms may get lost. (src/comm_brick.cpp:212)

# ---------- Define Interatomic Potential ---------------------
# Default potential (EAM alloy)
#variable potential_file string "/Users/chandan21gupta/Desktop/iit_delhi/agent_llms_3/mat-agent-bench/modal_app/potentials/EAM/CuAgAuNiPdPtAlPbFeMoTaWMgCoTiZr_Zhou04.eam.alloy"
#variable pair_style_type string "eam/alloy"

#if "${element} == C" then "variable potential_file string /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_3/mat-agent-bench/modal_app/potentials/TERSOFF/SiCGe.tersoff"
#if "${element} == C" then "variable pair_style_type string tersoff"

# Apply pair style
pair_style eam/alloy
pair_coeff * * /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_5/mat-agent-bench/tasks/lammps/lammps/ground_truth/potentials/Al/eam/Al99.eam.alloy Al

neighbor 2.0 bin
neigh_modify delay 10 check yes

# ---------- Define Settings ---------------------
compute eng all pe/atom
compute eatoms all reduce sum c_eng

# ---------- Run Minimization ---------------------
reset_timestep 0
#fix 1 all box/relax iso 0.0 vmax 0.001
thermo 10
thermo_style custom step pe lx ly lz press pxx pyy pzz c_eatoms
min_style cg
minimize 1.0e-10 1.0e-10 100000 100000
