units metal

atom_style atomic

# Define boundary conditions
boundary p p p

lattice fcc 4.05
region box block 0 5 0 5 0 5
create_box 1 box
create_atoms 1 box

# Define mass for atom type
mass 1 26.98

# Dump settings
thermo 100
thermo_style custom step temp epair etotal press vol

# Dumping the coordinates
 dump 1 all xyz 100 Aluminum.xyz

# Run the simulation
run 0