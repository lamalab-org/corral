# LAMMPS input for fcc Aluminum lattice
units           metal
dimension       3
boundary        p p p
atom_style      atomic

lattice         fcc 4.05
region          box block 0 5.0 0 5.0 0 5.0
create_box      1 box
create_atoms    1 box

# Define the mass for Aluminum
mass            1 26.98

# Set the timestep and run settings
timestep        0.001
thermo          100
dump            1 all xyz 100 structure.xyz
run             0
