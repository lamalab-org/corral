
# LAMMPS input file for FCC Aluminum
units metal

# Define lattice
lattice fcc 4.05
boundary p p p
region box block 0 5 0 5 0 5
create_box 1 box
create_atoms 1 box

# Define output
mass 1 26.98

# Dump coordinates to Al.xyz
thermo 100
thermo_style custom step temp etotal
 dump 1 all xyz 100 Al.xyz
run 0
