# Retrosynthesis Database Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file with real credentials to version control!

# Production Database Configuration
# This is the main database containing processed reactions, templates, and chemistry artifacts
RETRO_DB_HOST=localhost
RETRO_DB_PORT=5432
RETRO_DB_NAME=reactions_production_db
RETRO_DB_USER=postgres
RETRO_DB_PASSWORD=postgres

# Staging Database Configuration
# This is the Phase A database containing raw reaction data from various sources
STAGING_DB_HOST=localhost
STAGING_DB_PORT=5432
STAGING_DB_NAME=reactions_raw_db
STAGING_DB_USER=postgres
STAGING_DB_PASSWORD=postgres

# Optional override for the frozen local pricing database
# Defaults to retrosynthesis/data/buyables.sqlite in the installed package
RETRO_PRICE_DB_PATH=/path/to/buyables.sqlite
