LAMMPS (19 Nov 2024 - Development - patch_19Nov2024-56-ga78aee5731)
#------------------------Aluminum Simulation------------------#

# Initial setup
units           metal
dimension       3
processors      * * *
atom_style      atomic
boundary        p p p

#-------------------------Lattice Setup-----------------------#

# Define the aluminum lattice structure and create the simulation box

lattice         fcc 4.05             # FCC lattice for aluminum with lattice constant 4.05 Å
Lattice spacing in x,y,z = 4.05 4.05 4.05
region          box block 0 5 0 5 0 5 units lattice
create_box      1 box
Created orthogonal box = (0 0 0) to (20.25 20.25 20.25)
  1 by 1 by 1 MPI processor grid
create_atoms    1 box
Created 500 atoms
  using lattice units in orthogonal box = (0 0 0) to (20.25 20.25 20.25)
  create_atoms CPU = 0.001 seconds

#-------------------------Potential---------------------------#

# Define the potential for aluminum

pair_style      eam/alloy
pair_coeff      * * /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_5/mat-agent-bench/tasks/lammps/lammps/ground_truth/potentials/Al/eam/Al99.eam.alloy Al

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

#-----------------------Minimization--------------------------#

# Perform energy minimization
thermo          50
thermo_style    custom step atoms temp pe ke etotal press
min_style       sd
minimize        1.0e-10 1.0e-10 100000 100000
