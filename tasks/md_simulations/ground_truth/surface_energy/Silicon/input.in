units           real
atom_style      full
boundary        p p p

read_data       ../../structures/Si.data
replicate       2 2 2
#ask about region box size

# -----------------------------
# COMB3 Pair Style and Coefficients
# -----------------------------

pair_style      reaxff NULL safezone 100 mincap 10000
pair_coeff      * * ../../../../../../modal_app/potentials/REAXFF/ffield.reax Si

fix             qeq all qeq/reaxff 1 0.0 10.0 1e-6 reaxff

# -----------------------------
# Neighbor and Thermo Settings
# -----------------------------
neighbor        2.0 bin
neigh_modify    delay 10 check yes

# ---------- Define Settings ---------------------
compute eng all pe/atom
compute eatoms all reduce sum c_eng

# -----------------------------
# Energy Minimization
# -----------------------------
reset_timestep  0
thermo          10
thermo_style    custom step pe lx ly lz press pxx pyy pzz c_eatoms
min_style       cg
minimize        1.0e-10 1.0e-10 100000 100000

# ---------- Save Final Structure ---------------------
#write_data ../../minimised_structure/Si/Si_minimised_structure.data

# Store bulk energy BEFORE modifying the system
variable        Ebulk equal pe
variable        Ebulk_stored equal ${Ebulk}  # This will keep the bulk energy fixed

change_box      all boundary p p s  # Free surface in z-direction

write_data      Si_slab.data

# Minimize slab system
reset_timestep  0
thermo          100
min_style       cg
minimize        1.0e-10 1.0e-10 100000 100000

# Compute slab energy and surface energy
variable        Eslab equal pe

print "Slab Energy (eV): ${Eslab}"

print "Bulk Energy (eV): ${Ebulk_stored}"

variable        A equal lx*ly  # Surface area in Å²

print          "Area ${A}"

variable surface_energy equal (${Eslab}-${Ebulk_stored})/(${A}*2)


print "${surface_energy}" file surface_energy.txt
