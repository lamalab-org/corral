# Compute slab energy and surface energy
variable        Eslab equal pe

print "Slab Energy (eV): ${Eslab}"
Slab Energy (eV): -10015.3988705702

print "Bulk Energy (eV): ${Ebulk_stored}"
Bulk Energy (eV): -10884.1874017937

variable        A equal lx*ly  # Surface area in Å²

print          "Area ${A}"
Area 83.736141248448

variable surface_energy equal (${Eslab}-${Ebulk_stored})/(${A}*2)
variable surface_energy equal (-10015.3988705702-${Ebulk_stored})/(${A}*2)
variable surface_energy equal (-10015.3988705702--10884.1874017937)/(${A}*2)
variable surface_energy equal (-10015.3988705702--10884.1874017937)/(83.736141248448*2)


# Print surface energy in eV/Å²
print "${surface_energy}" file surface_energy.txt
