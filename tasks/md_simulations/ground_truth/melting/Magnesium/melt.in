#------------------------Silica Melt Simulation------------------#

#Initial setup
units           metal
dimension       3
processors      * * *
boundary        p p p

#----------------------------Setup----------------------------------#
#Creating new box
atom_style      atomic

#lattice        hcp 3.21
#region	box block 0 10 0 10 0 10 units lattice
#create_box	1 box
#create_atoms 1 box

#mass 1 24.30

read_data ../../structures/Mg.data
replicate 5 5 5


#-------------------------------Potential--------------------------#

pair_style eam/alloy
pair_coeff * * ../../../../../modal_app/potentials/EAM/Mg_Zhou04.eam.alloy Mg

neighbor        2.0 bin
neigh_modify    every 1 check yes
variable		dt equal 0.001
timestep        ${dt}

#-----------------------Thermo Output---------------------------------------------#

thermo          1000
thermo_style    custom step atoms temp pe ke press lx ly lz density
# thermo_modify 	lost ignore flush yes
# write_data		initial_system_ppp.dat

# Uniform distribution of atom as per velocities
velocity        all create 300.0 5812775 dist gaussian
fix             101 all nvt temp 300 300 $(100.0*dt)
run             10000
unfix           101

write_restart   npt_relaxation.restart
write_data      npt_relaxation.dat

#-----------------------NPT Relaxing---------------------------------------------#
dump            2 all custom 500 mdrelax300_reax.lammpstrj id type x y z
fix             1 all npt temp 300 300 $(100.0*dt) iso 0 0 $(1000.0*dt)
run             10000
unfix           1
undump          2

write_restart   relaxedsystem_300_reax.restart
write_data      relaxedsystem_300_reax.dat

#-----------------------NPT Heating---------------------------------------------#
dump            22 all custom 500 mdheat3000_reax.lammpstrj id type x y z
fix             11 all npt temp 300 2000 $(100.0*dt) iso 0 0 $(1000.0*dt)
#run             1350000
run             20000
unfix           11
undump          22

write_restart   heatedsystem_3000_reax.restart
write_data      heatedsystem_3000_reax.dat
