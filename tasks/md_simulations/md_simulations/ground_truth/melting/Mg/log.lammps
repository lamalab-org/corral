LAMMPS (19 Nov 2024 - Development - patch_19Nov2024-56-ga78aee5731)
#------------------------Silica Melt Simulation------------------#

#Initial setup
units           metal
dimension       3
processors      * * *
boundary        p p p

#----------------------------Setup----------------------------------#
#Creating new box
atom_style      atomic

lattice        hcp 3.21
Lattice spacing in x,y,z = 3.21 5.5598831 5.241908
region	box block 0 10 0 10 0 10 units lattice
create_box	1 box
Created orthogonal box = (0 0 0) to (32.1 55.598831 52.41908)
  1 by 2 by 2 MPI processor grid
create_atoms 1 box
Created 4000 atoms
  using lattice units in orthogonal box = (0 0 0) to (32.1 55.598831 52.41908)
  create_atoms CPU = 0.005 seconds

mass 1 24.30


#-------------------------------Potential--------------------------#

pair_style eam/alloy
pair_coeff * * /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_5/mat-agent-bench/modal_app/potentials/EAM/Mg_Zhou04.eam.alloy Mg
Reading eam/alloy potential file /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_5/mat-agent-bench/modal_app/potentials/EAM/Mg_Zhou04.eam.alloy with DATE: 2018-03-30

neighbor        2.0 bin
neigh_modify    every 1 check yes
variable		dt equal 0.001
timestep        ${dt}
timestep        0.001

#-----------------------Thermo Output---------------------------------------------#

thermo          1000
thermo_style    custom step atoms temp pe ke press lx ly lz density
# thermo_modify 	lost ignore flush yes
# write_data		initial_system_ppp.dat

# Uniform distribution of atom as per velocities
velocity        all create 300.0 5812775 dist gaussian
fix             101 all nvt temp 300 300 $(100.0*dt)
fix             101 all nvt temp 300 300 0.10000000000000000555
run             10000
