LAMMPS (19 Nov 2024 - Development - patch_19Nov2024-56-ga78aee5731)
#------------------------Silica Melt Simulation------------------#

#Initial setup
units           metal
dimension       3
processors      * * *
boundary        p p p

#----------------------------Setup----------------------------------#
#Creating new box
atom_style      atomic

#lattice        fcc 3.61
#region	box block 0 10 0 10 0 10 units lattice
#create_box	1 box
#create_atoms 1 box

#mass 1 63.54

read_data /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_5/mat-agent-bench/tasks/lammps/lammps/gt/melting/Al/heatedsystem_3000_reax.dat
Reading data file ...
  orthogonal box = (-0.35693996 -0.35693996 -0.35693996) to (40.85694 40.85694 40.85694)
  1 by 2 by 2 MPI processor grid
  reading atoms ...
  4000 atoms
  reading velocities ...
  4000 velocities
  read_data CPU = 0.065 seconds


#-------------------------------Potential--------------------------#

pair_style eam/alloy
pair_coeff * * /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_5/mat-agent-bench/modal_app/potentials/EAM/Al99.eam.alloy Al

neighbor        2.0 bin
neigh_modify    every 1 check yes
variable		dt equal 0.001
timestep        ${dt}
timestep        0.001

#-----------------------Thermo Output---------------------------------------------#

thermo          1000
thermo_style    custom step atoms temp pe ke press lx ly lz density

#-----------------------NPT Cooling---------------------------------------------#
dump            222 all custom 500 mdcool300_reax.lammpstrj id type x y z
fix             111 all npt temp 1000 300 $(100.0*dt) iso 0 0 $(1000.0*dt)
fix             111 all npt temp 1000 300 0.10000000000000000555 iso 0 0 $(1000.0*dt)
fix             111 all npt temp 1000 300 0.10000000000000000555 iso 0 0 1
#run             540000
run             10000
