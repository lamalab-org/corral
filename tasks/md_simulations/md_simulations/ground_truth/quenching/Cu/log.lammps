  1 by 2 by 2 MPI processor grid
  reading atoms ...
  4000 atoms
  reading velocities ...
  4000 velocities
  read_data CPU = 0.051 seconds


#-------------------------------Potential--------------------------#

pair_style eam/alloy
pair_coeff * * /Users/chandan21gupta/Desktop/iit_delhi/agent_llms_5/mat-agent-bench/modal_app/potentials/EAM/Cu_Zhou04.eam.alloy Cu
