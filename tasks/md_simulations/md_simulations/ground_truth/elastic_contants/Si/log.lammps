variable C3pos equal 138.196534684682
variable C4pos equal ${d4}
variable C4pos equal -24.2329588025628
variable C5pos equal ${d5}
variable C5pos equal -24.1247534386743
variable C6pos equal ${d6}
variable C6pos equal -24.2260567546635

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(64.4862314795532+${C1pos})
variable C13 equal 0.5*(64.4862314795532+64.4862288955396)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(64.4862238598464+${C2pos})
variable C23 equal 0.5*(64.4862238598464+64.4862347624669)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(138.196409193776+${C3pos})
variable C33 equal 0.5*(138.196409193776+138.196534684682)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
