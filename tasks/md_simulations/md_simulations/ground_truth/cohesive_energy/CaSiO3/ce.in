# Al2O3 Minimization using COMB3 Potential

units           real
atom_style      full
boundary        p p p

read_data       ../../structure/CaSiO3/CaSiO3.data
#replicate       2 2 2
#ask about region box size

# -----------------------------
# COMB3 Pair Style and Coefficients
# -----------------------------

pair_style      reaxff NULL safezone 100 mincap 10000
pair_coeff      * * ../../potentials/ffield.reax Si O Ca

fix             qeq all qeq/reaxff 1 0.0 10.0 1e-6 reaxff

# -----------------------------
# Neighbor and Thermo Settings
# -----------------------------
neighbor        2.0 bin
neigh_modify    delay 10 check yes

# ---------- Define Settings ---------------------
compute eng all pe/atom
compute eatoms all reduce sum c_eng

# -----------------------------
# Energy Minimization
# -----------------------------
reset_timestep  0
thermo          10
thermo_style    custom step pe lx ly lz press pxx pyy pzz c_eatoms
min_style       cg
minimize        1.0e-10 1.0e-10 100000 100000

# ---------- Save Final Structure ---------------------
#write_data ../../minimised_structure/Si/Si_minimised_structure.data

variable natoms equal "count(all)"
variable teng equal "c_eatoms"
variable length equal "lx"
variable ecoh equal "v_teng/v_natoms"

print "Total energy (eV) = ${teng};"
print "Number of atoms = ${natoms};"
#print "Lattice constant (Angstoms) = ${length};"
#print "Cohesive energy (eV) = ${ecoh};"
print "${ecoh}" file cohesive_energy.txt
