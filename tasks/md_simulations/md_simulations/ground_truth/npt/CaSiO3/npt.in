# Al2O3 Minimization using COMB3 Potential

units           real
atom_style      full
boundary        p p p

read_data       ../../structure/CaSiO3/CaSiO3.data
#replicate       2 2 2

pair_style      reaxff NULL safezone 100 mincap 10000
pair_coeff      * * ../../potentials/ffield.reax Ca Si O

fix             qeq all qeq/reaxff 1 0.0 10.0 1e-6 reaxff

# -----------------------------
# Neighbor and Thermo Settings
# -----------------------------
neighbor        2.0 bin
neigh_modify    delay 10 check yes

#-----------------------Minimization--------------------------#

# Perform energy minimization
thermo          50
thermo_style    custom step atoms temp pe ke etotal press
#min_style       sd
minimize        1.0e-10 1.0e-10 100000 100000

#write_data ../../minimised_structure/Si/Si_minimised_structure.data

#-------------------NPT Simulation for Density Calculation---#

# Perform NPT simulation to equilibrate the system
velocity        all create 300.0 12345
timestep        0.001
fix             npt all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0
dump            npt_dump all custom 1000 npt.lammpstrj id type x y z
thermo          100
thermo_style    custom step temp press density
run             10000
unfix           npt
undump          npt_dump


#-------------------Density Calculation---#
variable        final_density equal density
print           "${final_density}" file density.txt
