# ---------- Initialize Simulation ---------------------
clear
units           metal
dimension       3
processors      * * *
atom_style      atomic
boundary        p p p

# ---------- Create Atoms ---------------------
read_data       ../../structures/Al.data
replicate       5 5 5

pair_style eam/alloy
pair_coeff * * ../../../../../modal_app/potentials/EAM/Al99.eam.alloy Al

neighbor 2.0 bin
neigh_modify delay 10 check yes

# ---------- Define Settings ---------------------
compute eng all pe/atom
compute eatoms all reduce sum c_eng

# ---------- Run Minimization ---------------------
reset_timestep 0
#fix 1 all box/relax iso 0.0 vmax 0.001
thermo 10
thermo_style custom step pe lx ly lz press pxx pyy pzz c_eatoms
min_style cg
minimize 1.0e-10 1.0e-10 100000 100000

# ---------- Save Final Structure ---------------------
write_data Al_minimised_structure.dat

# ---------- Save Energy Output ---------------------
variable teng equal "c_eatoms"
print "${teng}" file Al_energy.txt

#print "All done!"
