# Compute slab energy and surface energy
variable        Eslab equal pe

print "Slab Energy (eV): ${Eslab}"
Slab Energy (eV): -8464.98048998755

print "Bulk Energy (eV): ${Ebulk_stored}"
Bulk Energy (eV): -8870.18844007836

variable        A equal lx*ly  # Surface area in Å²

print          "Area ${A}"
Area 51.894658730316

variable surface_energy equal (${Eslab}-${Ebulk_stored})/(${A}*2)
variable surface_energy equal (-8464.98048998755-${Ebulk_stored})/(${A}*2)
variable surface_energy equal (-8464.98048998755--8870.18844007836)/(${A}*2)
variable surface_energy equal (-8464.98048998755--8870.18844007836)/(51.894658730316*2)


# Print surface energy in eV/Å²
print "${surface_energy}" file surface_energy.txt
