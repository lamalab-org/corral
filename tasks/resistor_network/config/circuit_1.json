{
    "simple_series": {
        "name": "Simple Series Circuit Analysis",
        "description": "Determine the values of three unknown resistors. You are given resistance measurements between different points in the circuit. Submit a JSON file with the complete circuit topology including resistor values.",
        "tools": [
            "calculate_series_resistance",
            "simulate_circuit_resistance",
            "validate_measurements",
            "estimate_resistor_values"
        ],
        "scoring_function": "resistor_topology",
        "scoring_params": {
            "expected_topology": {
                "resistors": {
                    "R1": 10.0,
                    "R2": 20.0,
                    "R3": 30.0
                },
                "connections": [
                    [
                        "A",
                        "B",
                        "R1"
                    ],
                    [
                        "B",
                        "C",
                        "R2"
                    ],
                    [
                        "C",
                        "D",
                        "R3"
                    ]
                ]
            },
            "tolerance": 0.1,
            "use_functional_scoring": true,
            "topology_weight": 0.5,
            "functional_weight": 0.5,
            "exact_values_weight": 0.0
        },
        "submission_format": "JSON string with circuit topology (e.g., {\"resistors\": {\"R1\": 10.0, \"R2\": 20.0, \"R3\": 30.0}, \"connections\": [[\"A\", \"B\", \"R1\"], [\"B\", \"C\", \"R2\"], [\"C\", \"D\", \"R3\"]]})",
        "input_from_tasks": [],
        "initial_input": {
            "measurements": [
                {
                    "node_a": "A",
                    "node_b": "B",
                    "resistance": 10.0
                },
                {
                    "node_a": "B",
                    "node_b": "C",
                    "resistance": 20.0
                },
                {
                    "node_a": "C",
                    "node_b": "D",
                    "resistance": 30.0
                },
                {
                    "node_a": "A",
                    "node_b": "C",
                    "resistance": 30.0
                },
                {
                    "node_a": "A",
                    "node_b": "D",
                    "resistance": 60.0
                }
            ]
        }
    }
}
