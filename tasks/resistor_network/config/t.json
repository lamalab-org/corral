{
    "simple_series": {
        "name": "Simple Series Circuit Analysis",
        "description": "Determine the values of three unknown resistors. You are given resistance measurements between different points in the circuit. Submit a JSON file with the complete circuit topology including resistor values.",
        "tools": [
            "calculate_series_resistance",
            "simulate_circuit_resistance",
            "validate_measurements",
            "estimate_resistor_values"
        ],
        "scoring_function": "resistor_topology",
        "scoring_params": {
            "expected_topology": {
                "resistors": {
                    "R1": 10.0,
                    "R2": 20.0,
                    "R3": 30.0
                },
                "connections": [
                    [
                        "A",
                        "B",
                        "R1"
                    ],
                    [
                        "B",
                        "C",
                        "R2"
                    ],
                    [
                        "C",
                        "D",
                        "R3"
                    ]
                ]
            },
            "tolerance": 0.1
        },
        "submission_format": {
            "description": "JSON file with exact format specified below",
            "required_structure": {
                "resistors": {
                    "R1": "float - resistance value in ohms",
                    "R2": "float - resistance value in ohms",
                    "R3": "float - resistance value in ohms"
                },
                "connections": [
                    [
                        "node1",
                        "node2",
                        "resistor_id"
                    ],
                    "... additional connections"
                ]
            },
            "example": {
                "resistors": {
                    "R1": 10.0,
                    "R2": 20.0,
                    "R3": 30.0
                },
                "connections": [
                    [
                        "A",
                        "B",
                        "R1"
                    ],
                    [
                        "B",
                        "C",
                        "R2"
                    ],
                    [
                        "C",
                        "D",
                        "R3"
                    ]
                ]
            },
            "notes": [
                "Each connection is [node1, node2, resistor_id] where nodes are strings and resistor_id matches a key in resistors dict",
                "Resistor values must be positive numbers",
                "Node names should match those used in measurements",
                "Connection order does not matter: [A, B, R1] is equivalent to [B, A, R1]"
            ]
        },
        "input_from_tasks": [],
        "initial_input": {
            "measurements": [
                {
                    "node_a": "A",
                    "node_b": "B",
                    "resistance": 10.0
                },
                {
                    "node_a": "B",
                    "node_b": "C",
                    "resistance": 20.0
                },
                {
                    "node_a": "C",
                    "node_b": "D",
                    "resistance": 30.0
                },
                {
                    "node_a": "A",
                    "node_b": "C",
                    "resistance": 30.0
                },
                {
                    "node_a": "A",
                    "node_b": "D",
                    "resistance": 60.0
                }
            ],
            "circuit_constraints": {
                "num_resistors": 3,
                "terminal_nodes": [
                    "A",
                    "B",
                    "C",
                    "D"
                ],
                "topology_type": "unknown"
            }
        }
    },
