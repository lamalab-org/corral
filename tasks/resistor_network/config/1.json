{
    "simple_series": {
        "name": "Simple Series Circuit Analysis",
        "description": "Determine the values of three unknown resistors. You are given resistance measurements between different points in the circuit. Submit a JSON file with the complete circuit topology including resistor values.",
        "tools": [
            "calculate_series_resistance",
            "simulate_circuit_resistance",
            "validate_measurements",
            "estimate_resistor_values"
        ],
        "scoring_function": "resistor_topology",
        "scoring_params": {
            "expected_topology": {
                "resistors": {
                    "R1": 10.0,
                    "R2": 20.0,
                    "R3": 30.0
                },
                "connections": [
                    [
                        "A",
                        "B",
                        "R1"
                    ],
                    [
                        "B",
                        "C",
                        "R2"
                    ],
                    [
                        "C",
                        "D",
                        "R3"
                    ]
                ]
            },
            "tolerance": 0.1
        },
        "submission_format": {
            "resistors": {
                "R1": "float - resistance value in ohms",
                "R2": "float - resistance value in ohms",
                "additional resistors as needed": "float - resistance value in ohms"
            },
            "connections": [
                [
                    "node1 (example: A)",
                    "node2 (example: B)",
                    "resistor_id (example: R1)"
                ],
                "... additional connections"
            ]
        }
    },
    "input_from_tasks": [],
    "initial_input": {
        "measurements": [
            {
                "node_a": "A",
                "node_b": "B",
                "resistance": 10.0
            },
            {
                "node_a": "B",
                "node_b": "C",
                "resistance": 20.0
            },
            {
                "node_a": "C",
                "node_b": "D",
                "resistance": 30.0
            },
            {
                "node_a": "A",
                "node_b": "C",
                "resistance": 30.0
            },
            {
                "node_a": "A",
                "node_b": "D",
                "resistance": 60.0
            }
        ],
        "circuit_constraints": {
            "num_resistors": 3,
            "terminal_nodes": [
                "A",
                "B",
                "C",
                "D"
            ],
            "topology_type": "unknown"
        }
    }
}
