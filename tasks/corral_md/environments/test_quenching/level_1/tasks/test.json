{
    "silicon_quenching_1": {
        "name": "Quenching of Silicon - Level 1",
        "description": "Simulate the quenching process of Silicon by cooling its molten structure under NPT conditions using the Stillinger–Weber (SW) potential. Detect the glass transition temperature (Tg), defined as the temperature at which the slope of density versus temperature changes significantly. Report the Tg value in Kelvin.",
        "tools": [
            "get_potential_metadata",
            "get_structure_from_mp_text",
            "convert_structure_to_lammps_data",
            "run_lammps"
        ],
        "scoring_function": "check_numerical",
        "submission_format": "numerical value without units (eg. 56.00)",
        "initial_input": {
            "path to molten state": "/structures/melt/Silicon/melt.dat",
            "units": "metal",
            "pbc": "true",
            "timestep": "0.001 picoseconds",
            "quenching_rate" : "2.2 Kelvin/ps",
            "npt quench initial temperature": 2500,
            "npt quench final temperature": 300,
            "npt quench pressure": 0.0,
            "npt quench thermostat": "Nose-Hoover",
            "npt quench barostat": "Nose-Hoover",
            "atom_style": "full"
        },
        "scoring_params": {
            "target": 1066.9,
            "tolerance": 1e-1
        }
    }
}
