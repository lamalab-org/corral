{
    "sio2_quenching_3": {
        "name": "Quenching of SiO2 - Level 3",
        "description": "Simulate the quenching process of alpha quartz SiO2 and detect the glass transition temperature (Tg). Report the Tg value in Kelvin.",
        "tools": [
            "get_potential_metadata",
            "get_structure_from_mp_text",
            "convert_structure_to_lammps_data",
            "run_lammps",
            "get_nth_run_log",
            "keyword_log_extractor"
        ],
        "scoring_function": "check_numerical",
        "submission_format": "numerical value without units (eg. 56.00)",
        "initial_input": {
            "path to molten state": "/structures/melt/SiO2/melt.dat",
            "initial temperature": 5000,
            "final temperature": 1500,
            "quenching_rate": "3.5 kelvin/ps",
            "atom_style": "full"
        },
        "scoring_params": {
            "target": 1980.5,
            "tolerance": 1e-1
        }
    }
}
