{
    "sio2_quenching_1": {
        "name": "Quenching of SiO2 - Level 1",
        "description": "Simulate the quenching process of alpha-quartz SiO2 by cooling its molten structure under NPT conditions using the Tersoff potential. Detect the glass transition temperature (Tg), defined as the temperature at which the slope of density versus temperature changes significantly. Report the Tg value in Kelvin.",
        "tools": [
            "get_potential_metadata",
            "get_structure_from_mp_text",
            "convert_structure_to_lammps_data",
            "run_lammps"
        ],
        "scoring_function": "check_numerical",
        "submission_format": "numerical value without units (eg. 56.00)",
        "initial_input": {
            "path to molten state": "/structures/melt/SiO2/melt.restart",
            "units": "metal",
            "pbc": "true",
            "timestep": "0.001 picoseconds",
            "quenching_rate": "3.5 kelvin/ps",
            "npt quench initial temperature": 5000,
            "npt quench final temperature": 1500,
            "npt quench pressure": 0.0,
            "npt quench thermostat": "Nose-Hoover",
            "npt quench barostat": "Nose-Hoover",
            "atom_style": "full"
        },
        "scoring_params": {
            "target": 1980.5,
            "tolerance": 1e-1
        }
    }
}
