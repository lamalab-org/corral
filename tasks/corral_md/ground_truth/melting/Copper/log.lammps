LAMMPS (19 Nov 2024 - Development - patch_19Nov2024-56-ga78aee5731)
#------------------------Silica Melt Simulation------------------#

#Initial setup
units           metal
dimension       3
processors      * * *
boundary        p p p

#----------------------------Setup----------------------------------#
#Creating new box
atom_style      atomic

#lattice        fcc 3.61
#region	box block 0 10 0 10 0 10 units lattice
#create_box	1 box
#create_atoms 1 box

#mass 1 63.54

read_data ../../structures/Cu.data
Reading data file ...
  triclinic box = (0 0 0) to (3.577431 3.577431 3.577431) with tilt (0 0 0)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  4 atoms
  read_data CPU = 0.005 seconds
replicate 5 5 5
Replication is creating a 5x5x5 = 125 times larger system...
  triclinic box = (0 0 0) to (17.887155 17.887155 17.887155) with tilt (0 0 0)
  1 by 1 by 1 MPI processor grid
  500 atoms
  replicate CPU = 0.001 seconds


#-------------------------------Potential--------------------------#

pair_style eam/alloy
pair_coeff * * ../../../../../modal_app/potentials/EAM/Cu_Zhou04.eam.alloy Cu
Reading eam/alloy potential file ../../../../../modal_app/potentials/EAM/Cu_Zhou04.eam.alloy with DATE: 2018-03-30

neighbor        2.0 bin
neigh_modify    every 1 check yes
variable		dt equal 0.001
timestep        ${dt}
timestep        0.001

#-----------------------Thermo Output---------------------------------------------#

thermo          1000
thermo_style    custom step atoms temp pe ke press lx ly lz density
# thermo_modify 	lost ignore flush yes
# write_data		initial_system_ppp.dat

# Uniform distribution of atom as per velocities
velocity        all create 300.0 5812775 dist gaussian
fix             101 all nvt temp 300 300 $(100.0*dt)
fix             101 all nvt temp 300 300 0.10000000000000000555
run             10000
Neighbor list info ...
