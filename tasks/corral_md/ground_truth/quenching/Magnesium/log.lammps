LAMMPS (19 Nov 2024 - Development - patch_19Nov2024-56-ga78aee5731)
#------------------------Silica Melt Simulation------------------#

#Initial setup
units           metal
dimension       3
processors      * * *
boundary        p p p

#----------------------------Setup----------------------------------#
#Creating new box
atom_style      atomic

#lattice        fcc 3.61
#region	box block 0 10 0 10 0 10 units lattice
#create_box	1 box
#create_atoms 1 box

#mass 1 63.54

read_data ../../melting/Magnesium/heatedsystem_3000_reax.dat
Reading data file ...
  triclinic box = (-1.2666416 -1.096944 -2.0529687) to (17.126757 14.832209 27.758994) with tilt (-9.196702 0 0)
WARNING: Triclinic box skew is large. LAMMPS will run inefficiently. (src/domain.cpp:221)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  250 atoms
  reading velocities ...
  250 velocities
  read_data CPU = 0.005 seconds


#-------------------------------Potential--------------------------#

pair_style eam/alloy
pair_coeff * * ../../../../../modal_app/potentials/EAM/Mg_Zhou04.eam.alloy Mg
Reading eam/alloy potential file ../../../../../modal_app/potentials/EAM/Mg_Zhou04.eam.alloy with DATE: 2018-03-30

neighbor        2.0 bin
neigh_modify    every 1 check yes
variable		dt equal 0.001
timestep        ${dt}
timestep        0.001

#-----------------------Thermo Output---------------------------------------------#

thermo          1000
thermo_style    custom step atoms temp pe ke press lx ly lz density

#-----------------------NPT Cooling---------------------------------------------#
dump            222 all custom 500 mdcool300_reax.lammpstrj id type x y z
fix             111 all npt temp 2000 300 $(100.0*dt) iso 0 0 $(1000.0*dt)
fix             111 all npt temp 2000 300 0.10000000000000000555 iso 0 0 $(1000.0*dt)
fix             111 all npt temp 2000 300 0.10000000000000000555 iso 0 0 1
#run             540000
run             20000
