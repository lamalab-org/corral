[
  {
    "id": "psy_l1_t01_hsns_structure",
    "name": "HSNS factor structure discovery",
    "uuid": "b1f7c2ae-4a63-4a0e-9b5f-2c7c3e5a1d01",
    "keywords": [
      "psychometrics",
      "factor analysis",
      "model selection",
      "HSNS"
    ],
    "metrics": [
      "binary",
      "partial"
    ],
    "level": 1,
    "description": "You are given responses from an online personality survey. The codebook describes every column.\nRead the data and select participants from the United States. Report the one model for the Hypersensitive Narcissism Scale (HSNS) you would defend to a reviewer.",
    "submission_format": "A single JSON object:\n\n{\n  \"model_syntax\": \"<complete semopy model>\",\n  \"loadings\": {\"<item>\": <float>, ...},\n  \"factor_correlation\": <float or null>\n}\n\n`model_syntax` uses semopy syntax (`=~` loadings, `~~` (co)variances, `0*` to fix a parameter to zero).\n\n`loadings` gives, for each item you analysed, the largest absolute standardised loading that item has on any factor in your model.\n\n`factor_correlation` is the correlation between the factors when your model has exactly two correlated factors, and null otherwise.\n",
    "initial_input": {
      "public_inputs": [
        "codebook.md",
        "data.csv"
      ],
      "dataset": "data.csv",
      "codebook": "codebook.md",
      "data_sha256": "5b261b3a83f78c270fa0f00d03648bd1f83503684e5b8b5746c977f592c5cdca"
    },
    "tools": [],
    "scoring_function": "score_model_criteria",
    "scoring_params": {
      "data_dir": "artifacts/level_1/task_01",
      "truth_path": "truth/level_1/task_01.json",
      "dataset": "data.csv",
      "subset": {
        "country": "US"
      },
      "items": [
        "HSNS1",
        "HSNS2",
        "HSNS3",
        "HSNS4",
        "HSNS5",
        "HSNS6",
        "HSNS7",
        "HSNS8",
        "HSNS9",
        "HSNS10"
      ],
      "scorer_estimator": "ML",
      "response_type": "continuous",
      "missing_responses": "empty_fields",
      "refit_submitted_syntax": true,
      "syntax_whitelist": {
        "items": [
          "HSNS1",
          "HSNS2",
          "HSNS3",
          "HSNS4",
          "HSNS5",
          "HSNS6",
          "HSNS7",
          "HSNS8",
          "HSNS9",
          "HSNS10"
        ],
        "operators": [
          "=~",
          "~~",
          "~"
        ],
        "max_factors": 6
      },
      "method": "constraints_then_pareto_then_claims",
      "aggregation": "all_tiers_must_pass",
      "emit": [
        "score_binary",
        "score_partial",
        "checks_vector"
      ],
      "tier_1_constraints": [
        {
          "key": "converged"
        },
        {
          "key": "no_negative_variance"
        },
        {
          "key": "positive_df"
        },
        {
          "key": "finite_standard_errors",
          "max_standard_error": 10.0
        },
        {
          "key": "no_redundant_factor",
          "phi_max": 0.9
        },
        {
          "key": "no_collapsed_factor",
          "min_salient_loading": 0.3,
          "min_salient_per_factor": 2,
          "sign_reversal_at": -0.1
        }
      ],
      "reference_role": "floor",
      "tier_2_comparative": [
        {
          "key": "CFI",
          "direction": "higher",
          "eps": 0.005,
          "criterion": "global_fit"
        },
        {
          "key": "RMSEA",
          "direction": "lower",
          "eps": 0.005,
          "criterion": "global_fit"
        },
        {
          "key": "SRMR",
          "direction": "lower",
          "eps": 0.005,
          "criterion": "global_fit"
        },
        {
          "key": "BIC",
          "direction": "lower",
          "eps": 10.0,
          "criterion": "parsimony"
        },
        {
          "key": "sigma_max_abs_deviation",
          "direction": "lower",
          "eps": 0.01,
          "criterion": "accuracy"
        }
      ],
      "tier_3_claims": [
        {
          "key": "loadings",
          "fn": "score_vector",
          "truth_key": "scored.loadings",
          "tol": 0.08,
          "all_must_be_within": true,
          "criterion": "parameter_quality"
        },
        {
          "key": "factor_correlation",
          "fn": "score_scalar",
          "truth_key": "scored.factor_correlation",
          "tol": 0.06,
          "applicable_if": "model_has_two_oblique_factors",
          "criterion": "parameter_quality"
        },
        {
          "key": "item_assignment",
          "fn": "score_partition",
          "derive_from": "refit_primary_loadings",
          "truth_key": "scored.item_assignment",
          "criterion": "structure"
        }
      ],
      "recorded_fields": [
        "chi_square_p",
        "chi_square_df"
      ]
    },
    "public_sha256": {
      "codebook.md": "6014d6a6403729e49ff14f8bc25dda457939ccbe00fff42756f82b30fdfc32da",
      "data.csv": "5b261b3a83f78c270fa0f00d03648bd1f83503684e5b8b5746c977f592c5cdca"
    }
  }
]
