    "id": "psy_l1_t06_latent_relationships",
    "name": "Relationships between the instruments' dimensions",
    "uuid": "5b83d1f6-47ae-4c39-9d20-3f7154e8c606",
    "keywords": [
      "psychometrics",
      "measurement error",
