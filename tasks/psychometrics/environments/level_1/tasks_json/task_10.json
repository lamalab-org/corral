    "id": "psy_l1_t10_item_integrity",
    "name": "Which items are bad, and which is the data?",
    "uuid": "9a51c7e0-4bd8-4f36-83a2-1e6cd4907b55",
    "keywords": [
      "psychometrics",
      "data quality",
      "item analysis",
