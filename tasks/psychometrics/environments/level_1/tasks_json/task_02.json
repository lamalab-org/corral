        "items": [
          "DDP1",
          "DDP2",
          "DDP3",
          "DDP4",
          "DDN1",
          "DDN2",
          "DDN3",
          "DDN4",
          "DDM1",
          "DDM2",
          "DDM3",
          "DDM4"
        ],
        "operators": [
          "=~",
          "~~",
          "~"
        ],
        "max_factors": 6
      },
      "method": "constraints_then_pareto_then_claims",
      "aggregation": "all_tiers_must_pass",
      "emit": [
        "score_binary",
        "score_partial",
        "checks_vector"
      ],
      "tier_1_constraints": [
        {
          "key": "converged"
        },
        {
          "key": "no_negative_variance"
        },
        {
          "key": "positive_df"
        },
        {
