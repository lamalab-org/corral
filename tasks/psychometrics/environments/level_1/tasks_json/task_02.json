    "level": 1,
    "description": "You are given responses from an online personality survey. The codebook describes every column.\n\nRead the data and select participants from the United States. Identify the theoretically plausible psychometric models for the Dirty Dozen.",
    "submission_format": "A single JSON object:\n\n{\n  \"model_syntax\": \"<complete lavaan/semopy model>\",\n  \"loadings\": {\"<item>\": <float>, ...}\n}\n\n`model_syntax` uses lavaan notation (`=~` loadings, `~~` (co)variances, `0*` to fix a parameter to zero).\n\n`loadings` gives, for each item you analysed, the largest absolute standardised loading that item has on any factor in your model.\n",
    "initial_input": {
      "public_inputs": [
        "codebook.md",
        "data.csv"
      ],
      "dataset": "data.csv",
      "codebook": "codebook.md",
      "data_sha256": "d4fe78e17107a81a1fd8ad73303c363560e2f73d9e186230335bf657d67f78b0"
    },
    "tools": [],
    "scoring_function": "score_model_criteria",
    "scoring_params": {
      "data_dir": "artifacts/level_1/task_02",
      "truth_path": "truth/level_1/task_02.json",
      "dataset": "data.csv",
      "subset": {
        "country": "US"
      },
      "items": [
        "DDP1",
        "DDP2",
        "DDP3",
        "DDP4",
        "DDN1",
        "DDN2",
        "DDN3",
        "DDN4",
        "DDM1",
        "DDM2",
        "DDM3",
        "DDM4"
      ],
      "scorer_estimator": "ML",
      "refit_submitted_syntax": true,
