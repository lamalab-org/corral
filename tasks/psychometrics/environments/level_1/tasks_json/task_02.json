        },
        {
          "key": "no_redundant_factor",
          "phi_max": 0.9
        },
        {
          "key": "no_collapsed_factor",
          "min_salient_loading": 0.3,
          "min_salient_per_factor": 2,
          "sign_reversal_at": -0.1
        }
      ],
      "reference_role": "floor",
      "tier_2_comparative": [
        {
          "key": "CFI",
          "direction": "higher",
          "eps": 0.005,
          "criterion": "global_fit"
        },
        {
          "key": "RMSEA",
          "direction": "lower",
          "eps": 0.005,
          "criterion": "global_fit"
        },
        {
          "key": "SRMR",
          "direction": "lower",
          "eps": 0.005,
          "criterion": "global_fit"
        },
        {
          "key": "BIC",
          "direction": "lower",
          "eps": 10.0,
          "criterion": "parsimony"
        },
        {
          "key": "sigma_max_abs_deviation",
          "direction": "lower",
          "eps": 0.01,
          "criterion": "accuracy"
