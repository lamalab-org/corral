          "tol": 0.08,
          "all_must_be_within": true,
          "criterion": "parameter_quality"
        },
        {
          "key": "item_assignment",
          "fn": "score_partition",
          "derive_from": "refit_primary_loadings",
          "truth_key": "scored.item_assignment",
