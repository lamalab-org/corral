[
  {
    "id": "psy_l1_t05_defensible_comparisons",
    "name": "Which gender comparisons are defensible?",
    "uuid": "e91c6b74-3a85-4d02-b1f7-6c2e8a9d4505",
    "keywords": [
      "psychometrics",
      "measurement invariance",
      "item bias",
      "group comparison",
      "validity"
    ],
    "metrics": [
      "binary",
      "partial"
    ],
    "level": 1,
    "description": "You are given responses from an online personality survey. The codebook describes every column.\n\nRead the data and select participants from the United States who reported male or female. Investigate how far the Hypersensitive Narcissism Scale (HSNS) measures the same thing in men and in women, and on that basis decide which of the following comparisons between the two groups are psychometrically defensible:\n\n  factor_structure               do the same items measure the same factor\n  loadings                       does the trait relate to its items the same way\n  factor_variances               is the spread of the trait comparable\n  association_with_other_trait   is its relationship with the Dark Triad narcissism\n                                 items comparable\n  latent_means                   is the average level of the trait comparable\n  observed_score_means           are the average total scores comparable\n\nCarry out the comparisons you judge defensible, and report the correlation between the two traits in each group.\n\nItems are five-point ordinal ratings and 0 denotes a missing response.\n",
    "submission_format": "A single JSON object:\n\n{\n  \"model_syntax\": \"<complete lavaan/semopy model>\",\n  \"comparisons\": {\n    \"factor_structure\": <true|false>, \"loadings\": <true|false>,\n    \"factor_variances\": <true|false>, \"association_with_other_trait\": <true|false>,\n    \"latent_means\": <true|false>, \"observed_score_means\": <true|false>\n  },\n  \"trait_correlation_men\": <float>,\n  \"trait_correlation_women\": <float>\n}\n\n`model_syntax` is the measurement model you used, in lavaan notation (`=~` loadings,\n`~~` (co)variances). It is re-fitted during evaluation, so it must be complete and\nrunnable.\n",
    "initial_input": {
      "public_inputs": [
        "codebook.md",
        "data.csv"
      ],
      "dataset": "data.csv",
      "codebook": "codebook.md",
      "data_sha256": "cf5f0bcca61896cf6c7fd5ad8ee2031f8993b666fed42d0bdd6ac6928b132fd1"
    },
    "tools": [],
    "scoring_function": "score_model_criteria",
    "scoring_params": {
      "data_dir": "artifacts/level_1/task_05",
      "truth_path": "truth/level_1/task_05.json",
      "dataset": "data.csv",
      "subset": {
        "country": "US",
        "gender": [
          1,
          2
        ]
      },
      "items": [
        "HSNS1",
        "HSNS2",
        "HSNS3",
        "HSNS4",
        "HSNS5",
        "HSNS6",
        "HSNS7",
        "HSNS8",
        "HSNS9",
        "HSNS10",
        "DDN1",
        "DDN2",
        "DDN3",
        "DDN4"
      ],
      "scorer_estimator": "ML",
      "refit_submitted_syntax": true,
      "syntax_whitelist": {
        "items": [
          "HSNS1",
          "HSNS2",
          "HSNS3",
          "HSNS4",
          "HSNS5",
          "HSNS6",
          "HSNS7",
          "HSNS8",
          "HSNS9",
          "HSNS10",
          "DDN1",
          "DDN2",
          "DDN3",
          "DDN4",
          "gender"
        ],
        "operators": [
          "=~",
          "~~",
          "~"
        ],
        "max_factors": 6
      },
      "method": "constraints_then_pareto_then_claims",
      "aggregation": "all_tiers_must_pass",
      "emit": [
        "score_binary",
        "score_partial",
        "checks_vector"
      ],
      "tier_1_constraints": [
        {
          "key": "converged"
        },
        {
          "key": "no_negative_variance"
        },
        {
          "key": "positive_df"
        },
        {
          "key": "finite_standard_errors",
          "max_standard_error": 10.0
        },
        {
          "key": "no_redundant_factor",
          "phi_max": 0.9
        },
        {
          "key": "no_collapsed_factor",
          "min_salient_loading": 0.3,
          "min_salient_per_factor": 2,
          "sign_reversal_at": -0.1
        }
      ],
      "reference_role": "floor",
      "tier_2_comparative": [
        {
          "key": "CFI",
          "direction": "higher",
          "eps": 0.005,
          "criterion": "global_fit"
        },
        {
          "key": "RMSEA",
          "direction": "lower",
          "eps": 0.005,
          "criterion": "global_fit"
        },
        {
          "key": "SRMR",
          "direction": "lower",
          "eps": 0.005,
          "criterion": "global_fit"
        },
        {
          "key": "BIC",
          "direction": "lower",
          "eps": 10.0,
          "criterion": "parsimony"
        },
        {
          "key": "sigma_max_abs_deviation",
          "direction": "lower",
          "eps": 0.01,
          "criterion": "accuracy"
        }
      ],
      "tier_3_claims": [
        {
          "key": "comparisons",
          "fn": "score_boolean_panel",
          "truth_key": "scored.comparisons",
          "criterion": "defensibility"
        },
        {
          "key": "trait_correlation_men",
          "fn": "score_scalar",
          "truth_key": "scored.trait_correlation_men",
          "tol": 0.06,
          "criterion": "group_comparison"
        },
        {
          "key": "trait_correlation_women",
          "fn": "score_scalar",
          "truth_key": "scored.trait_correlation_women",
          "tol": 0.06,
          "criterion": "group_comparison"
        }
      ],
      "recorded_fields": [
        "chi_square_p",
        "chi_square_df"
      ]
    },
    "public_sha256": {
