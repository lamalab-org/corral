    "id": "psy_l2_t05_duplicate_records",
    "name": "What explains the apparent relationship?",
    "uuid": "1d2c5a7e-3f44-4c8b-9a10-6b5e2f7c9d31",
    "keywords": [
      "psychometrics",
      "data integrity",
